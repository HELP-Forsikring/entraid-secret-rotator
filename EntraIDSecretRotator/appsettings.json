{
  "Rotator": {
    "AppFilter": "myfilter",
    "Output": "table",
    "Days": 30,
    "NotExpired": false,
    "DryRun": false,
    "ValidityDays": 180,
    "KeyVaults": []
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Azure": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"],
    "Properties": {
      "Application": "EntraIDSecretRotator"
    }
  }
}
